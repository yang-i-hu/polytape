# Sweeps orphaned scratch hourly (and shortly after boot), so a hard-killed offload's
# leftover multi-GB tar staging can never accumulate to ENOSPC on /data. Install
# (deploy/bootstrap.sh does this):
#   sudo install -m 0755 deploy/polytape-scratch-janitor.sh /opt/polytape/polytape-scratch-janitor.sh
#   sudo cp deploy/polytape-scratch-janitor.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now polytape-scratch-janitor.timer
[Unit]
Description=Run polytape scratch janitor hourly

[Timer]
OnBootSec=3min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
