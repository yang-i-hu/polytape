# polytape recorder — systemd unit (campaign: open-ended, multi-family).
#
# Records every event listed in /etc/polytape/campaign_events.json in ONE process
# into /data/run-maker. That file is written by scripts/list_campaign_events.py from
# the campaign spec /etc/polytape/campaign.json (sports main lines for several
# leagues inside a lookahead window + the live/next hourly crypto strike ladders).
# polytape-refresh.timer re-discovers the set every 10 min and restarts this unit
# ONLY when the (event, recorded-market) set actually changed.
#
# Install: deploy/bootstrap.sh does all of this. By hand:
#   sudo cp deploy/polytape.service /etc/systemd/system/polytape.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now polytape
#   sudo journalctl -u polytape -f
#
# Env files (unchanged from the WC deployment):
#   /etc/polytape/polytape.env    0600 polytape:polytape — REQUIRED (may be empty:
#                                 a public-feed capture needs no secrets)
#   /etc/polytape/heartbeat.env   0640 root:polytape — optional
#     POLYTAPE_HEARTBEAT_URL=https://hc-ping.com/<uuid>   (arms the dead-man's switch)
#
# Restart=always recovers crashes and the refresh roll-over; on a *persistent* fatal
# (e.g. disk full -> exit 2) the process keeps dying, nothing is written, and the
# external heartbeat (if armed) goes quiet -> alert. systemd alone would loop silently.
# RequiresMountsFor=/data: never start — and never write into the small root fs — if
# the data disk (a separate pd-balanced volume mounted with `nofail`) is not mounted.

[Unit]
Description=polytape Polymarket recorder (campaign)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=simple
User=polytape
Group=polytape
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/polytape/polytape.env
EnvironmentFile=-/etc/polytape/heartbeat.env
ExecStart=/opt/polytape/venv/bin/polytape --matches-file /etc/polytape/campaign_events.json --open-only --run-name maker --no-per-match --out /data --log-level INFO
# Legacy single-event mode (writes /data/event-<id>); swap the ExecStart above for:
#   ExecStart=/opt/polytape/venv/bin/polytape --event-id ${POLYTAPE_EVENT_ID} --out /data --log-level INFO
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
# One per-match handle per open event (hundreds on a CFB Saturday) + shards + meta
# temp files: leave real headroom over the 1024 default.
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polytape
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
