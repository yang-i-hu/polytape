# polytape offloader — moves what the recorder has FINISHED with to a Coldline GCS
# bucket and removes it from local disk: finished matches' per-match native dirs
# (matches/event-<id>/) and sealed monolith segments. On an open-ended campaign this
# is what keeps /data bounded — without it the run only ever grows.
#
# Oneshot, triggered hourly by polytape-offload.timer. Runs as the recorder user
# `polytape` (it only touches polytape-owned files under /data; nothing here needs
# root). SAFE: a local file is deleted ONLY after its archive is uploaded AND verified
# in GCS; a still-recording match / the live segment is never touched. See
# polytape/admin/offload.py.
#
# Auth: Application Default Credentials from the VM's ATTACHED service account
# (<offload-sa>@<gcp-project>.iam.gserviceaccount.com, objectAdmin on the
# archive bucket only, instance scope storage-rw). There is NO key file on this VM —
# do not set POLYTAPE_GCS_KEY / GOOGLE_APPLICATION_CREDENTIALS in offload.env.
#
# Config: /etc/polytape/offload.env (see deploy/offload.env.example; bootstrap.sh
# writes it). The uploader uses /opt/polytape/venv with the [admin] extra installed
# (google-cloud-storage); the admin dashboard itself is NOT deployed.

[Unit]
Description=polytape offloader (finished matches + sealed segments -> GCS Coldline)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data

[Service]
Type=oneshot
User=polytape
Group=polytape
EnvironmentFile=/etc/polytape/offload.env
# Be gentle on the shared disk so the live recorder never starves for I/O.
IOSchedulingClass=idle
Nice=10
ExecStart=/opt/polytape/venv/bin/python -m polytape.admin.offload --log-level INFO
# The offloader writes ONLY under /data (tar scratch, markers, deletes of archived
# files); everything else read-only. It never touches the live monolith segment.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polytape-offload

[Install]
WantedBy=multi-user.target
