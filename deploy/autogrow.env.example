# Config for polytape-autogrow.sh — copy to /etc/polytape/autogrow.env and edit.
# Only AUTOGROW_DISK is required; project/zone auto-resolve from the metadata server.

# GCP disk NAME backing /data (NOT the Linux device), e.g. AUTOGROW_DISK=<disk-name>.
# Find it with: gcloud compute disks list
AUTOGROW_DISK=

# Optional overrides (defaults shown):
# AUTOGROW_MOUNT=/data
# AUTOGROW_THRESHOLD_PCT=85     # grow when used% >= this
# AUTOGROW_INCREMENT_GB=50      # GB added per grow
# AUTOGROW_MAX_GB=500           # HARD cost ceiling — never grows past this
# AUTOGROW_PROJECT=<gcp-project>  # default: auto-resolved from the metadata server
# AUTOGROW_ZONE=<zone>            # default: auto-resolved from the metadata server
