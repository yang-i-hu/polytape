# Config for polytape-autogrow.sh — copy to /etc/polytape/autogrow.env and edit.
# Only AUTOGROW_DISK is required; project/zone auto-resolve from the metadata server.

# GCP disk NAME backing /data (NOT the Linux device); find it: gcloud compute disks list
AUTOGROW_DISK=<disk-name>

# Optional overrides (defaults shown):
# AUTOGROW_MOUNT=/data
# AUTOGROW_THRESHOLD_PCT=85     # grow when used% >= this
# AUTOGROW_INCREMENT_GB=50      # GB added per grow
# AUTOGROW_MAX_GB=500           # HARD cost ceiling — never grows past this
# AUTOGROW_PROJECT=<gcp-project> # default: this VM's project (metadata server)
# AUTOGROW_ZONE=<zone>          # default: this VM's zone (metadata server)
