# /etc/polytape/offload.env — config for polytape-offload.service (and read by the
# scratch janitor for POLYTAPE_SCRATCH_DIR). deploy/bootstrap.sh writes this file;
# copy + edit by hand only for a non-standard run name / bucket.
#
# NO SECRETS HERE, ON PURPOSE. The offloader authenticates with Application Default
# Credentials from the VM's attached service account (objectAdmin on the archive
# bucket only). Do NOT add POLYTAPE_GCS_KEY or GOOGLE_APPLICATION_CREDENTIALS — there
# is no key file on this VM and none should be created.

# The run the recorder writes (polytape.service: --run-name maker --out /data).
POLYTAPE_RUN_DIR=/data/run-maker
# Archive bucket (the SA has objectAdmin on this bucket and nothing else).
POLYTAPE_GCS_BUCKET=polytape-prod-194347-archive
# Object prefix = this campaign's namespace in the bucket, apart from the World Cup
# run's objects (matches/, run-wc/). Finished matches -> <prefix>/event-<id>.tar.gz,
# closed daily segments -> <prefix>/segments/book.<day>.jsonl.zst.
POLYTAPE_GCS_PREFIX=run-maker
POLYTAPE_GCS_STORAGE_CLASS=COLDLINE
# Transient tar scratch — MUST be on the data volume, never the 20 GB root fs.
POLYTAPE_SCRATCH_DIR=/data/tmp/polytape-offload
